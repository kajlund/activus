{
  "name": "activus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @activus/contracts build && concurrently --kill-others --names contracts,api,web \"pnpm --filter @activus/contracts dev\" \"pnpm --filter @activus/api dev\" \"pnpm --filter @activus/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @activus/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @activus/contracts build && pnpm -r --if-present test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
